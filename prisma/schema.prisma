// Prisma schema for the QR bill-pay platform (MVP).
// Dev uses SQLite for zero-setup local runs; swap the datasource to
// postgresql for production (see README).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// A HoReCa venue (restaurant/cafe/bar/pub) — the merchant.
model Business {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  passwordHash    String
  feePercent      Float    @default(2.0) // platform take rate, snapshotted onto each Payment
  serviceFeePercent Float  @default(0) // owner-set customer-facing service charge, snapshotted onto each Payment
  orderingEnabled Boolean  @default(false) // owner-level toggle: allow "order after scan"
  idramMerchantId String? // set once the business has real Idram merchant credentials
  createdAt       DateTime @default(now())

  tables         Table[]
  menuCategories MenuCategory[]
  menuItems      MenuItem[]
  bills          Bill[]
  orders         Order[]
}

// Groups menu items for the owner's item-entry UI and the staff "tap to add"
// bill picker, e.g. "Salads", "Pizza".
model MenuCategory {
  id         String   @id @default(cuid())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
  name       String
  createdAt  DateTime @default(now())

  menuItems MenuItem[]

  @@unique([businessId, name])
}

// One printed QR per physical table. The QR encodes a stable token;
// which bill it resolves to changes as bills open/close.
model Table {
  id         String   @id @default(cuid())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
  name       String
  qrToken    String   @unique @default(cuid())
  createdAt  DateTime @default(now())

  bills  Bill[]
  orders Order[]

  @@unique([businessId, name])
}

model MenuItem {
  id         String        @id @default(cuid())
  business   Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
  category   MenuCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId String?
  name       String
  priceAmd   Int // whole AMD (dram); Armenia has no smaller circulating unit in practice
  imageUrl   String? // optional photo shown on the staff bill-picker and customer ordering grid
  available  Boolean       @default(true)
  createdAt  DateTime      @default(now())

  orderItems OrderItem[]
  billItems  BillItem[]
}

enum BillStatus {
  OPEN
  PAID
  CANCELLED
}

// A bill is opened by staff for a table and holds the line items that
// customers can pay against (in full, split, or item-by-item).
model Bill {
  id         String     @id @default(cuid())
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
  table      Table      @relation(fields: [tableId], references: [id], onDelete: Cascade)
  tableId    String
  status     BillStatus @default(OPEN)
  createdAt  DateTime   @default(now())
  closedAt   DateTime?

  items    BillItem[]
  payments Payment[]
}

// One line of the bill, e.g. "Khinkali x4". paidAmd tracks how much of
// unitPriceAmd * quantity has already been covered by (successful)
// payments, in AMD rather than whole units — that's what lets a customer
// pay for just part of a single shared item (see PaymentItemShare).
model BillItem {
  id           String    @id @default(cuid())
  bill         Bill      @relation(fields: [billId], references: [id], onDelete: Cascade)
  billId       String
  menuItem     MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  menuItemId   String? // set when added from the menu picker, so repeat taps increment quantity
  name         String
  unitPriceAmd Int
  quantity     Int
  paidAmd      Int       @default(0)

  shares PaymentItemShare[]
}

enum PaymentMethod {
  IDRAM_WALLET
  CARD
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

// One customer's payment against a bill. Can cover specific items
// (via PaymentItemShare) and/or an evenly-split amount, plus a tip.
model Payment {
  id                 String        @id @default(cuid())
  bill               Bill          @relation(fields: [billId], references: [id], onDelete: Cascade)
  billId             String
  itemsAmountAmd     Int // portion covering bill items
  serviceFeeAmd      Int           @default(0) // serviceFeePercent snapshot, on top of itemsAmountAmd
  tipAmountAmd       Int           @default(0)
  totalAmd           Int // itemsAmountAmd + serviceFeeAmd + tipAmountAmd = what the customer is charged
  platformFeeAmd     Int // totalAmd * feePercent snapshot, for payout reconciliation
  method             PaymentMethod
  status             PaymentStatus @default(PENDING)
  payerName          String?
  idramTransactionId String?
  failureReason      String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  itemShares PaymentItemShare[]
}

// Join table: how much (in AMD) of a given BillItem's cost a Payment
// covers. AMD-based rather than a whole-unit count so a customer can pay
// for just their share of one shared item, not only whole units.
model PaymentItemShare {
  id         String   @id @default(cuid())
  payment    Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  paymentId  String
  billItem   BillItem @relation(fields: [billItemId], references: [id], onDelete: Cascade)
  billItemId String
  amdAmount  Int

  @@unique([paymentId, billItemId])
}

enum OrderStatus {
  PLACED
  ACKNOWLEDGED
  PREPARING
  DELIVERED
  CANCELLED
}

// Optional "order after scan" flow — only reachable when the business has
// orderingEnabled = true.
model Order {
  id         String      @id @default(cuid())
  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
  table      Table       @relation(fields: [tableId], references: [id], onDelete: Cascade)
  tableId    String
  status     OrderStatus @default(PLACED)
  note       String?
  createdAt  DateTime    @default(now())

  items OrderItem[]
}

model OrderItem {
  id         String    @id @default(cuid())
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    String
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id])
  menuItemId String?
  name       String
  unitPriceAmd Int
  quantity   Int
}
